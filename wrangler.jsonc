{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustee",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "trustee-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "trustee-docs" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": { "preview": { "name": "trustee-preview", "vars": { "APP_NAME": "Trustee (preview)", "APP_URL": "https://trustee-preview.example.workers.dev", "VAPID_SUBJECT": "mailto:admin@example.com", "VAPID_PUBLIC_KEY": "", "EMAIL_FROM": "Trustee <noreply@example.com>", "TEST_MODE": "1" }, "d1_databases": [{ "binding": "DB", "database_name": "trustee-preview", "database_id": "d337f6c8-d5fa-4f4b-811a-6f5900874a2c", "migrations_dir": "migrations" }], "r2_buckets": [{ "binding": "DOCS", "bucket_name": "trustee-preview-docs", "jurisdiction": "eu" }], "kv_namespaces": [{ "binding": "KV", "id": "849f0c0a5e634f668deb7eea3767e137" }], "triggers": { "crons": [] } }, "test": { "vars": { "APP_NAME": "Trustee", "APP_URL": "http://localhost:5199", "VAPID_SUBJECT": "mailto:test@example.com", "VAPID_PUBLIC_KEY": "", "EMAIL_FROM": "Trustee <test@example.com>" }, "d1_databases": [{ "binding": "DB", "database_name": "trustee-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }], "r2_buckets": [{ "binding": "DOCS", "bucket_name": "trustee-docs" }], "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_ID" }] } },
  "vars": {
    "APP_NAME": "Trustee",
    "APP_URL": "http://localhost:5173",
    "VAPID_SUBJECT": "mailto:admin@example.com",
    "VAPID_PUBLIC_KEY": "",
    "EMAIL_FROM": "Trustee <noreply@example.com>"
  }
}
