{
  "name": "trustee-demo-edge",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "trustee.m-dm.org", "custom_domain": true }],
  "vars": { "ORIGIN": "https://trustee-origin.garde-robe.app" },
