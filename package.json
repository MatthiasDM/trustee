{
  "name": "trustee",
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.json && vitest run && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply trustee-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trustee-db --remote",
    "db:seed:local": "wrangler d1 execute trustee-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute trustee-db --remote --file=./seed/seed.sql",
    "seed:generate": "node scripts/seed.mjs",
    "vapid": "node scripts/gen-vapid.mjs",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:env": "node scripts/test-env.mjs start",
    "test:env:stop": "node scripts/test-env.mjs stop",
    "test:env:reset": "node scripts/test-env.mjs reset",
    "test:api": "node scripts/test-env.mjs reset && node scripts/test-env.mjs start && vitest run --config vitest.scenarios.config.ts; node scripts/test-env.mjs stop",
    "test:ui": "node scripts/test-env.mjs stop; playwright test",
    "test:all": "npm run test && npm run test:api && npm run test:ui",
    "demo:release": "scripts/host-demo.sh"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
